# ──────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────
node_modules/
package-lock.json.bak

# ──────────────────────────────────────────────
# Environment & Secrets — NEVER commit these
# Covers root, server/.env, client/.env and any variant.
# The .env.example templates stay tracked.
# ──────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
!**/.env.example
!**/.env.*.example
*.local

# Certificates & Private Keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
*.pub

# Credentials & Service Accounts
credentials.json
client_secret*.json
serviceAccountKey*.json
*.passwd

# ──────────────────────────────────────────────
# Database Dumps & Local Stores
# ──────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump
*.sql
*.rdb

# ──────────────────────────────────────────────
# Build & Bundle Output
# ──────────────────────────────────────────────
dist/
client/dist/
build/
dist-ssr/

# ──────────────────────────────────────────────
# Logs & Diagnostic Dumps
# ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────────
# Test & Coverage
# ──────────────────────────────────────────────
coverage/
.nyc_output/

# ──────────────────────────────────────────────
# Tool Caches
# ──────────────────────────────────────────────
.vite/
.eslintcache
*.tsbuildinfo

# ──────────────────────────────────────────────
# Operating System & Editor Files
# ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────────
# Temporary & Backup Files
# ──────────────────────────────────────────────
*.bak
*.tmp
*~
