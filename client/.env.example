# ─────────────────────────────────────────────────────────────
# CampusConnect client — environment template
# Copy this file to client/.env and adjust if needed.
#
# ⚠️ All VITE_* variables are embedded into the browser bundle —
# never put secrets in this file.
# ─────────────────────────────────────────────────────────────

# Base URL of the CampusConnect REST API. This is public configuration, not a secret.
# Leave at the local default for development; set to the deployed API URL in production.
VITE_API_URL=http://localhost:5000/api
