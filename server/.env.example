# ─────────────────────────────────────────────────────────────
# CampusConnect API — environment template
# Copy this file to server/.env and fill in real values.
# ─────────────────────────────────────────────────────────────

# ---- Database (required) ----
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority

# ---- Auth (required) ----
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- CORS ----
# Exact origin of the client app (credentials are enabled, so it must match precisely)
CLIENT_URL=http://localhost:5173

# ---- Seed script safety ----
# The seed script deletes ALL users, events and registrations.
# It refuses to run unless SEED_CONFIRM=true (or the --force flag is passed).
SEED_CONFIRM=false
# Optional overrides for the provisioned administrator account:
SEED_ADMIN_EMAIL=admin@nie.ac.in
SEED_ADMIN_PASSWORD=change-me-immediately
