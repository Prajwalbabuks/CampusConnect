# ─────────────────────────────────────────────────────────────
# CampusConnect API — environment template
# Copy this file to server/.env and fill in real values.
# ─────────────────────────────────────────────────────────────

# ---- Database (required) ----
# Required. Use a local or Atlas MongoDB URI. Do not commit the real URI.
MONGO_URI=
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority

# ---- Auth (required) ----
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required. Generate locally with the command above; do not commit the secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- CORS ----
# Exact origin of the client app (credentials are enabled, so it must match precisely)
CLIENT_URL=http://localhost:5173

# ---- Seed Admin (required only when provisioning the Seed Admin account) ----
# Fill these locally. The seed script never prints the password and preserves existing records.
SEED_ADMIN_EMAIL=
# Use 14–72 characters with lowercase, uppercase, a number, and a special character.
SEED_ADMIN_PASSWORD=
